{
  "schema": "ups-signal-taxonomy",
  "version": "1.3.0",
  "generated_at": "2026-01-05",
  "purpose": "Vendor-neutral taxonomy of signal types that contribute to Urgent Patch Score (UPS) timelines and scoring. Signal types are source-agnostic; sources are captured per event instance (vendor/feed/url/confidence).",
  "design_principles": [
    "Vendor-neutral signal_type names; source attribution lives in signal events.",
    "Prefer earliest verifiable timestamp per signal_type for 'first_seen'.",
    "Avoid double counting by applying group caps and/or deduplication rules.",
    "Separate 'publication_time' from 'event_time' when sources provide both.",
    "Exploitability/ITW evidence should dominate predictive/buzz signals."
  ],
  "scoring_guidance": {
    "recommended_thresholds": {
      "watch": 5,
      "track": 7,
      "prepare": 9,
      "urgent_patch": 10,
      "emergency": 14,
      "ir_mode": 17
    },
    "group_caps": {
      "exploitation_claims": 8,
      "campaign_context": 5,
      "exploit_maturity": 6,
      "scanner_validation": 3,
      "defensive_signatures": 3,
      "external_telemetry": 4,
      "exposure_reachability": 4,
      "compromise_evidence": 6,
      "remediation_dynamics": 3,
      "predictive_signals": 2,
      "buzz_interest": 1
    },
    "deduplication_rules": [
      "Within a group, count only the highest-weight signal_type per 24h window unless sources are independent and add new evidence (e.g., new IoC sets).",
      "Treat reposts/syndications as the same source_family; keep only the earliest publication_time.",
      "If EXPLOITED_CATALOG_ADDED exists with due_date, do not separately add a second 'directive' signal for the same catalog."
    ]
  },
  "timestamp_semantics": {
    "first_seen": "Earliest time the signal is publicly available or observable in telemetry.",
    "most_recent": "Most recent time the signal is observed/updated.",
    "publication_time": "Time the source published the information (blog post, advisory, rule release).",
    "event_time": "Time the underlying activity occurred (e.g., exploitation began), if explicitly stated by the source.",
    "measurement_time": "Time an exposure/scan/telemetry measurement was taken, if distinct from publication_time."
  },
  "confidence_scale": {
    "range": [
      0.0,
      1.0
    ],
    "bands": [
      {
        "min": 0.9,
        "max": 1.0,
        "label": "primary / authoritative / direct evidence"
      },
      {
        "min": 0.7,
        "max": 0.89,
        "label": "credible secondary / corroborated"
      },
      {
        "min": 0.4,
        "max": 0.69,
        "label": "plausible OSINT / partial evidence"
      },
      {
        "min": 0.1,
        "max": 0.39,
        "label": "weak proxy / noisy indicator"
      }
    ]
  },
  "event_instance_schema": {
    "required_fields": [
      "subject_id",
      "subject_type",
      "signal_type",
      "group",
      "ts",
      "source"
    ],
    "subject_types": [
      "cve",
      "bdu",
      "vendor_advisory",
      "misconfig",
      "campaign"
    ],
    "ts": "Use publication_time if available; otherwise first_seen. Store event_time separately when available.",
    "source": {
      "required_fields": [
        "vendor",
        "feed",
        "url_or_ref",
        "confidence"
      ],
      "optional_fields": [
        "source_family",
        "title",
        "author",
        "retrieved_at"
      ]
    },
    "example": {
      "subject_id": "CVE-2025-59718",
      "subject_type": "cve",
      "signal_type": "EXPLOITED_CATALOG_ADDED",
      "group": "exploitation_claims",
      "ts": "2025-12-16T00:00:00Z",
      "fields": {
        "catalog": "KEV",
        "date_added": "2025-12-16",
        "due_date": "2025-12-23"
      },
      "source": {
        "vendor": "CISA",
        "feed": "KEV",
        "url_or_ref": "https://www.cisa.gov/known-exploited-vulnerabilities-catalog",
        "confidence": 0.95,
        "source_family": "gov_catalog"
      }
    }
  },
  "groups": [
    {
      "group": "exploitation_claims",
      "description": "Authoritative claims of in-the-wild exploitation or inclusion in exploited-vuln catalogs."
    },
    {
      "group": "campaign_context",
      "description": "Context that increases urgency: ransomware/botnet activity, threat-actor association, exploit type, chaining."
    },
    {
      "group": "exploit_maturity",
      "description": "Availability, maturity and operationalization of exploit tooling (PoC/weaponized/framework/commercial)."
    },
    {
      "group": "scanner_validation",
      "description": "Presence and quality of validation checks in scanners and assessment tools."
    },
    {
      "group": "defensive_signatures",
      "description": "Availability of defensive detection/protection content (IDS/IPS/WAF/EDR rules)."
    },
    {
      "group": "external_telemetry",
      "description": "External observation of scanning/exploitation waves and telemetry-based confirmations."
    },
    {
      "group": "exposure_reachability",
      "description": "How reachable and prevalent the vulnerable surface is (org-specific exposure and public exposure estimates)."
    },
    {
      "group": "compromise_evidence",
      "description": "Evidence of compromise and post-exploitation artifacts/outcomes."
    },
    {
      "group": "remediation_dynamics",
      "description": "Patch/mitigation availability and dynamics that correlate with urgent risk (OOB, bypass, incomplete fix)."
    },
    {
      "group": "predictive_signals",
      "description": "Predictive/thermometric indicators (EPSS growth/acceleration) used as weak amplifiers."
    },
    {
      "group": "buzz_interest",
      "description": "Noisy attention signals; should not alone trigger urgent actions."
    }
  ],
  "signals": [
