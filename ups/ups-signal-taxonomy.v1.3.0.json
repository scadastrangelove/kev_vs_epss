  "changelog": [
    {
      "version": "1.2.0",
      "date": "2026-01-05",
      "changes": [
        "Added stage floor semantics (min_stage) for critical signals so stage cannot remain below a required minimum.",
        "Added top-level stage_floors for tooling that prefers centralized policy.",
        "No change to default weights."
      ]
    }
  ],
  "stage_floors": {
    "Urgent Patch": [
      "EXPLOITED_CATALOG_ADDED",
      "WEAPONIZED_EXPLOIT_AVAILABLE",
      "FRAMEWORK_MODULE_AVAILABLE"
    ],
    "Emergency / IR": [
      "MDR_IR_CONFIRMED_INTRUSIONS",
      "TELEMETRY_CONFIRMED_ITW",
      "VENDOR_CONFIRMED_ITW",
      "CERT_CSIRT_ALERT_ITW"
    ]
  },
  "meta": {
    "notes": "v1.3.0 adds KEV-neutral phase policy triggers (Track/Prepare) and optional vkev-only ignoring support."
  },
  "phase_policy": {
    "version": "1.3.0",
    "windows": {
      "pressure_window": "7d",
      "poc_pressure_window": "14d"
    },
    "baseline_signal_types": [
      "VULN_PUBLISHED",
      "RECORD_LAST_MODIFIED"
    ],
    "vkev_detection": {
      "enabled_by_default": false,
      "match_in": [
        "source_url",
        "comment"
      ],
      "substrings": [
        "vulncheck",
        "vkev"
      ]
    },
    "signal_sets": {
      "pre_exploitation_pressure": [
        "SCAN_WAVE_INDICATOR",
        "HONEYPOT_EXPLOIT_ATTEMPTS",
        "COMMUNITY_TEMPLATE_ACTIVE_CHECK",
        "IOC_PUBLISHED_ATTEMPT_LEVEL"
      ],
      "active_check_signals": [
        "COMMUNITY_TEMPLATE_ACTIVE_CHECK",
        "SCANNER_ACTIVE_CHECK"
      ],
      "attempt_telemetry": [
        "SCAN_WAVE_INDICATOR",
        "HONEYPOT_EXPLOIT_ATTEMPTS",
        "IOC_PUBLISHED_ATTEMPT_LEVEL"
      ],
      "poc_signals": [
        "PUBLIC_POC_RELEASED"
      ],
      "initial_access": [
        "EXPLOIT_TYPE_INITIAL_ACCESS"
      ],
      "botnet_wormable": [
        "BOTNET_WORMABLE_ASSOCIATION"
      ]
    },
    "triggers": [
      {
        "id": "T1_track_on_multi_pressure",
        "min_stage": "Track",
        "logic": {
          "type": "distinct_count_in_window",
          "set": "pre_exploitation_pressure",
          "window": "pressure_window",
          "gte": 2
        }
      },
      {
        "id": "T2_prepare_on_initial_access_plus_pressure",
        "min_stage": "Prepare",
        "logic": {
          "type": "and",
          "all": [
            {
              "type": "seen",
              "set": "initial_access"
            },
            {
              "type": "any_in_window",
              "set": "attempt_telemetry",
              "window": "pressure_window"
            }
          ]
        }
      },
      {
        "id": "T3_prepare_on_botnet_plus_pressure",
        "min_stage": "Prepare",
        "logic": {
          "type": "and",
          "all": [
            {
              "type": "seen",
              "set": "botnet_wormable"
            },
            {
              "type": "any_in_window",
              "set": "attempt_telemetry",
              "window": "pressure_window"
            }
          ]
        }
      },
      {
        "id": "T4_prepare_on_poc_plus_active_check",
        "min_stage": "Prepare",
        "logic": {
          "type": "and",
          "all": [
            {
              "type": "seen",
              "set": "poc_signals"
            },
            {
              "type": "any_in_window",
              "set": "active_check_signals",
              "window": "poc_pressure_window"
            }
          ]
        }
      }
    ]
  }
}