      "default_weight": 1,
      "evidence_strength": "high",
      "typical_lag": "none",
      "timestamp_fields": [
        "published_time"
      ],
      "fields_schema": {
        "published_time": "datetime",
        "source_optional": "string|null"
      }
    },
    {
      "signal_type": "RECORD_LAST_MODIFIED",
      "group": "remediation_dynamics",
